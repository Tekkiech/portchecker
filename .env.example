# Copy this file to .env (same directory as docker-compose.yml) and fill in
# real values. .env is gitignored - this is the only auth-related file that
# should ever be checked into git.
#
# Leaving both unset (or deleting .env) disables auth entirely, same as the
# default out-of-the-box behavior.

AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
